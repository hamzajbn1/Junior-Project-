# Local planner configuration. Copy to .env; restart the Flask backend after edits.
# These values are read by the backend, not exposed as browser environment values.
PLANNER_BASE_URL=http://127.0.0.1:11434
PLANNER_MODEL=qwen3:1.7b
PLANNER_TIMEOUT_SECONDS=90
PLANNER_CONTEXT_TOKENS=4096
PLANNER_MAX_OUTPUT_TOKENS=700
